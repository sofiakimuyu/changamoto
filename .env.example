# Supabase shared-leaderboard credentials.
# Copy to `.env.local` (git-ignored) and fill in from your Supabase project:
#   Project Settings → Data API / API  →  Project URL and the anon / public key.
# These are safe to expose in a static client — access is limited by Row Level
# Security (see supabase/schema.sql). Leave unset to run with the local
# simulated leaderboard instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
